# Konfigurasi Monday.com API v2
# Dapatkan API Key di: Monday.com -> Profile Avatar (kiri bawah) -> Developers -> My Access Tokens
MONDAY_API_KEY=your_monday_personal_api_token_here

# ID Board Monday.com
# Dapatkan dari URL board, contoh: https://your-workspace.monday.com/boards/1234567890 -> Board ID adalah 1234567890
MONDAY_BOARD_ID=1234567890
